# Copy to .env (never committed). Nothing here is needed for `make check`.
# Metaculus bot account token: API and submissions.
METACULUS_TOKEN=
# AskNews (either secret name works).
ASKNEWS_CLIENT_ID=
ASKNEWS_CLIENT_SECRET=
# Hosted models: Metaculus's sponsored credits arrive as an OpenRouter key.
# Never add a paid balance. :free models cost nothing on any key.
OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# GITHUB_TOKEN=
# Ordered chains, endpoint:model. The first forecast model must be in the
# frontier tier for --submit outside the bot-testing-area.
# AUGUR_FORECAST_MODELS=openrouter:openai/gpt-5.1,openrouter:anthropic/claude-sonnet-5.5
# AUGUR_RESEARCH_MODELS=openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# Without the chains: one endpoint and model for both roles (local by default).
AUGUR_PROVIDER=ollama
AUGUR_MODEL=qwen2.5:7b
# Another OpenAI-compatible host:
# AUGUR_ENDPOINT_MYHOST_URL=https://example.com/v1
# AUGUR_ENDPOINT_MYHOST_KEY_ENV=MYHOST_API_KEY
# AUGUR_ENDPOINT_MYHOST_BILLING=free
# AUGUR_REPLAY_PATH=data/recordings/m1-dryrun.jsonl
# AUGUR_RECORD_PATH=
# AUGUR_PROBE=1
AUGUR_LEDGER=./augur.db
AUGUR_MAX_QUESTIONS_PER_RUN=10
AUGUR_MAX_COST_PER_QUESTION=0.50
AUGUR_MAX_COST_PER_RUN=5.00
AUGUR_FORECASTERS=5
AUGUR_LOG_LEVEL=INFO
